{
  "name": "informaticauco/simplesamlphp-module-ucofilter",
  "description": "A SimpleSAMLphp 2.x module to filter and transform attributes with ExpressionLanguage",
  "license": "MIT",
  "authors": [
    {
      "name": "Sergio Gómez",
      "email": "sergio@uco.es"
    }
  ],
  "type": "simplesamlphp-module",
  "autoload": {
    "psr-4": {
      "SimpleSAML\\Module\\ucofilter\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\SimpleSAML\\Module\\ucofilter\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.2",
    "simplesamlphp/composer-module-installer": "^1.3",
    "symfony/expression-language": "^6.4|^7.0"
  },
  "require-dev": {
    "simplesamlphp/simplesamlphp": "^2.5",
    "phpunit/phpunit": "^10.5"
  }
}
